{
  "name": "badminton-matching-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend: Express 5 + MongoDB (Mongoose)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed:demo": "node src/utils/seedDemo.js",
    "db:init-replset": "node src/utils/initReplicaSet.js"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/setup/globalTeardown.js",
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/database.js",
      "!src/utils/seedDemo.js",
      "!src/utils/initReplicaSet.js"
    ],
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "statements": 80,
        "branches": 70
      }
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
