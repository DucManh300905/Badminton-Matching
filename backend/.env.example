PORT=8080
CLIENT_URL=http://localhost:5173

# MongoDB trên máy phải chạy dạng replica set (rs0) để dùng transaction
MONGODB_URI=mongodb://localhost:27017/badminton_matching?replicaSet=rs0

# Dùng cho: npm run seed:demo (mặc định Demo@123)
DEMO_PASSWORD=Demo@123

# >= 32 ký tự ngẫu nhiên, server từ chối khởi động nếu yếu. Tạo: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string

# Số lớp proxy đứng trước backend, để giới hạn đăng nhập đếm đúng IP người dùng:
#   chạy trực tiếp trên máy: để trống · máy chủ chạy thật (Cloudflare → nginx, xem docs/DEPLOY.md): 1
TRUST_PROXY=

# Thư mục lưu ảnh đại diện / ảnh bìa. Để trống = backend/uploads (chạy trên máy).
#   máy chủ chạy thật: /var/lib/badminton/uploads (Nginx phục vụ trực tiếp, xem docs/DEPLOY.md)
UPLOAD_DIR=

# Gửi email (WBS 4.14): quên mật khẩu, báo chủ kèo có ảnh chuyển khoản. Để trống = không gửi (chạy trên máy: in nội dung thư ra log).
#   máy chủ chạy thật: Gmail riêng của app + "mật khẩu ứng dụng" 16 ký tự (xem docs/DEPLOY.md mục 3.3)
SMTP_USER=
SMTP_PASS=
# Không bắt buộc (mặc định smtp.gmail.com:465, người gửi = SMTP_USER)
SMTP_HOST=
SMTP_PORT=
MAIL_FROM=
# Địa chỉ web trong link của thư; để trống = CLIENT_URL
APP_URL=
