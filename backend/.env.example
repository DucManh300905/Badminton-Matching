PORT=8080
CLIENT_URL=http://localhost:5173

# MongoDB trên máy phải chạy dạng replica set (rs0) để dùng transaction
MONGODB_URI=mongodb://localhost:27017/badminton_matching?replicaSet=rs0

# Dùng cho: npm run seed:demo (mặc định Demo@123)
DEMO_PASSWORD=Demo@123

# >= 32 ký tự ngẫu nhiên, server từ chối khởi động nếu yếu. Tạo: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string

# Số lớp proxy đứng trước backend, để giới hạn đăng nhập đếm đúng IP người dùng:
#   chạy trực tiếp trên máy: để trống · sau nginx / Render: 1
TRUST_PROXY=
